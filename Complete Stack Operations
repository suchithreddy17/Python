class Stack:
    def __init__(self):
        self.l = []

    def push(self, a):
        self.l.append(a)

    def pop(self):
        return self.l.pop()

    def display(self):
        print(self.l)

    def peek(self):
        print(self.l[-1])

s = Stack()

s.push(10)
s.push(20)
s.push(30)

s.display()

s.peek()

print("Popped Element:", s.pop())

s.display()
